# Environment Configuration Example
DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production-1234567890
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DB_NAME=shopcrm
DB_USER=shopcrm
DB_PASSWORD=shopcrm_password
DB_HOST=localhost
DB_PORT=5432

# Timezone
TIME_ZONE=UTC

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=redispassword

# Meta Lead Ads Integration
META_GRAPH_VERSION=v22.0
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=your_meta_verify_token_here
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
META_PAGE_ID=
META_WEBHOOK_MAX_BYTES=1048576

# Reverse Proxy (Nginx)
NUM_PROXIES=1
